---
interface Props {
  name: string;
  size?: number;
  class?: string;
  strokeWidth?: number;
}

const { name, size = 24, class: className = '', strokeWidth = 1.8 } = Astro.props;

// Iconos estilo "línea" (inspirados en Lucide, MIT).
const paths: Record<string, string> = {
  megaphone: '<path d="m3 11 18-5v12L3 14v-3z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/>',
  palette: '<path d="M12 22a10 10 0 1 1 10-10c0 1.7-1.3 3-3 3h-2.5a2.5 2.5 0 0 0-2 4c.9.9 1.4 1.8.8 3-.6 1.1-2 1.5-3.3 1z"/><circle cx="7.8" cy="11.8" r=".6" fill="currentColor"/><circle cx="10.6" cy="7.6" r=".6" fill="currentColor"/><circle cx="14.8" cy="7.2" r=".6" fill="currentColor"/>',
  target: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.2" fill="currentColor"/>',
  chart: '<line x1="3" y1="20" x2="21" y2="20"/><line x1="7" y1="16" x2="7" y2="10"/><line x1="12" y1="16" x2="12" y2="4"/><line x1="17" y1="16" x2="17" y2="13"/>',
  users: '<path d="M16 21v-1.5a4 4 0 0 0-4-4H6.5a4 4 0 0 0-4 4V21"/><circle cx="9.2" cy="7.5" r="3.8"/><path d="M21.5 21v-1.5a4 4 0 0 0-3-3.9"/><path d="M15.6 3.9a3.8 3.8 0 0 1 0 7.2"/>',
  sparkles: '<path d="M12 3 13.9 9.4a2 2 0 0 0 1.3 1.3L21.6 12l-6.4 1.3a2 2 0 0 0-1.3 1.3L12 21l-1.9-6.4a2 2 0 0 0-1.3-1.3L2.4 12l6.4-1.3a2 2 0 0 0 1.3-1.3L12 3z"/>',
  instagram: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="3.6"/><circle cx="17.4" cy="6.6" r="1" fill="currentColor" stroke="none"/>',
  mail: '<rect x="2.5" y="5" width="19" height="14" rx="2.5"/><path d="m3.5 7 8.5 6 8.5-6"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.2 2"/>',
  zap: '<path d="M13 2 4.5 13.5H11L9.5 22 18 10.5h-6.5L13 2z"/>',
  check: '<path d="m4.5 12.5 5 5L19.5 6"/>',
  arrowRight: '<path d="M4 12h16"/><path d="m14 6 6 6-6 6"/>',
  arrowLeft: '<path d="M20 12H4"/><path d="m10 6-6 6 6 6"/>',
  star: '<path d="M12 2.5 14.9 9l7 .8-5.2 4.8 1.4 6.9L12 18.1 5.9 21.5l1.4-6.9L2.1 9.8l7-.8L12 2.5z" fill="currentColor" stroke="none"/>',
  menu: '<line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/>',
  x: '<line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/>',
  plus: '<line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>',
  trending: '<path d="M3 17l6.2-6.2 4.3 4.3L21 7.5"/><path d="M15 7.5h6v6"/>',
  calendar: '<rect x="3" y="5" width="18" height="16" rx="3"/><line x1="8" y1="3" x2="8" y2="7"/><line x1="16" y1="3" x2="16" y2="7"/><line x1="3" y1="10" x2="21" y2="10"/>',
  external: '<path d="M14 4h6v6"/><path d="M20 4 11 13"/><path d="M20 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h5"/>',
};

const body = paths[name] ?? '';
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={body}
/>
