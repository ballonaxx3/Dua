---
import { site, navLinks } from '../data/site';
import Icon from './Icon.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header" id="siteHeader">
  <nav class="nav" aria-label="Navegación principal">
    <a href="/" class="logo" aria-label="Dua Marketing — Inicio">
      <span class="logo__mark">D</span>
      <span class="logo__text">
        <span class="logo__name">Dua Marketing</span>
        <span class="logo__sub">Strategy</span>
      </span>
    </a>

    <ul class="nav__links">
      {navLinks.map((link) => (
        <li>
          <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <a href="/contacto" class="nav__cta">
      Agenda gratis
      <Icon name="arrowRight" size={15} strokeWidth={2.2} />
    </a>

    <button class="nav__toggle" id="navToggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobilePanel">
      <Icon name="menu" size={20} />
    </button>
  </nav>
</header>

<div class="mobile-panel" id="mobilePanel" hidden>
  <ul>
    {navLinks.map((link) => (
      <li>
        <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
          {link.label}
          <Icon name="arrowRight" size={16} />
        </a>
      </li>
    ))}
    <li>
      <a href="/contacto" style="color: var(--gold-bright); font-weight: 700;">
        Agenda una consulta gratuita
        <Icon name="arrowRight" size={16} />
      </a>
    </li>
  </ul>
</div>
