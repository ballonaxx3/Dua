---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout path="/404" title="Página no encontrada" description="La página que buscas no existe. Vuelve al inicio de Dua Marketing.">
  <section class="notfound">
    <p class="eyebrow" style="justify-content: center;">Error 404</p>
    <h1>Ups.</h1>
    <p style="color: var(--muted); max-width: 380px;">La página que buscas no existe o fue movida. Volvamos a lo importante: hacer crecer tu marca.</p>
    <a href="/" class="btn btn--gold" style="margin-top: .5rem;">Volver al inicio</a>
  </section>
</BaseLayout>
