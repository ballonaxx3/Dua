---
import '../styles/global.css';
import { site } from '../data/site';
import Preloader from '../components/Preloader.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  /** Ruta absoluta desde la raíz, ej: /servicios */
  path?: string;
}

const { title, description = site.description, path = Astro.url.pathname } = Astro.props;

const canonical = new URL(path, Astro.site ?? 'https://duamarketing.com').href;
const ogImage = new URL('/profecional.png', Astro.site ?? 'https://duamarketing.com').href;
const pageTitle = path === '/' ? `${site.name} | ${site.tagline}` : `${title} | ${site.name}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0C0B09" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.legalName} />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Datos estructurados: negocio local / profesional de servicios -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'ProfessionalService',
      name: site.legalName,
      description: site.description,
      url: Astro.site?.href ?? 'https://duamarketing.com',
      email: site.email,
      sameAs: [site.instagram],
      openingHours: 'Mo-Fr 09:00-18:00',
      founder: { '@type': 'Person', name: 'Dua Marketing' },
    })} />

    <!-- Fuentes: Fraunces (display editorial) + Outfit (texto) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&family=Outfit:wght@300..800&display=swap"
      rel="stylesheet"
    />

    <!-- Marca `html.js` antes del primer paint: el contenido oculto por
         animaciones de reveal solo aplica si hay JS activo -->
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>

  <body>
    <Preloader />
    <Nav />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <script src="../scripts/main.ts"></script>
  </body>
</html>
